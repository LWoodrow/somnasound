{
  "display_information": {
    "name": "Somnasound Engine (local)"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "Somnasound Engine (local)",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "channels:read",
        "channels:join",
        "files:write",
        "channels:history"
      ]
    }
  },
  "settings": {
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "interactivity": {
      "is_enabled": true
    },
    "event_subscriptions": {
      "bot_events": ["message.channels"]
    },
    "token_rotation_enabled": false,
    "app_level_token_rotation_enabled": false,
    "is_mcp_enabled": false
  }
}
